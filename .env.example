# Backend only. Copy to .env and supply your AI Studio key.
GEMINI_API_KEY=
# Strongest reasoning model; override if your account requires another compatible model.
GEMINI_MODEL=gemini-4-carbon
# Turn-based dictation and spoken answers use separate speech-capable models.
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
